{{ 'luxury-footer.css' | asset_url | stylesheet_tag }}
{%- if section.settings.payment_enable -%}
  {{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #LuxuryFooter-{{ section.id }} {
    --footer-bg: {{ section.settings.footer_bg_color | default: '#0D0D0D' }};
    --footer-radius: {{ section.settings.footer_border_radius | default: 0 }}px;
    --footer-outer-margin: {{ section.settings.outer_margin | default: 0 }}px;
    --footer-heading-color: {{ section.settings.heading_color | default: '#FFFFFF' }};
    --footer-text-color: {{ section.settings.text_color | default: '#A3A3A3' }};
    --footer-link-hover-color: {{ section.settings.link_hover_color | default: '#FFFFFF' }};
    --footer-padding-top: {{ section.settings.padding_vertical | default: 56 }}px;
    --footer-padding-bottom: 0px;
    --wordmark-font-size: {{ section.settings.wordmark_font_size | default: 170 }}px;
    --wordmark-font-weight: {{ section.settings.wordmark_font_weight | default: '800' }};
    --wordmark-letter-spacing: {{ section.settings.wordmark_letter_spacing | default: 2 }}px;
    --wordmark-solid-color: {{ section.settings.wordmark_solid_color | default: '#1F1F1F' }};
    --wordmark-gradient-start: {{ section.settings.wordmark_gradient_start | default: '#1E3B2B' }};
    --wordmark-gradient-end: {{ section.settings.wordmark_gradient_end | default: '#62B587' }};
    --wordmark-gradient-direction: {{ section.settings.wordmark_gradient_direction | default: '135deg' }};
  }
{%- endstyle -%}

<div class="luxury-footer-wrapper" style="--footer-outer-margin: {{ section.settings.outer_margin | default: 0 }}px;">
  <footer
    id="LuxuryFooter-{{ section.id }}"
    class="luxury-footer"
    role="contentinfo"
  >
    <div class="luxury-footer__container page-width">
      <!-- 4-Column Desktop Grid -->
      <div class="luxury-footer__grid">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'brand_contact' -%}
                <!-- COLUMN 1: Brand Info + Contact Us (All in ONE Column) -->
                <div class="luxury-footer__col luxury-footer__col--brand" {{ block.shopify_attributes }}>
                  <!-- Logo or Brand Text -->
                  <div class="luxury-footer__brand-header">
                    {%- if block.settings.brand_logo != blank -%}
                      {%- assign logo_height = block.settings.brand_logo_width | divided_by: block.settings.brand_logo.aspect_ratio | round -%}
                      {%- assign brand_logo_alt = block.settings.brand_logo.alt | default: shop.name | escape -%}
                      <a href="{{ routes.root_url }}" class="luxury-footer__logo-link" aria-label="{{ shop.name }}">
                        {{
                          block.settings.brand_logo
                          | image_url: width: 600
                          | image_tag:
                            class: 'luxury-footer__logo',
                            width: block.settings.brand_logo_width,
                            height: logo_height,
                            alt: brand_logo_alt,
                            loading: 'lazy'
                        }}
                      </a>
                    {%- else -%}
                      <a href="{{ routes.root_url }}" class="luxury-footer__brand-title">
                        {{ block.settings.brand_text | default: 'SEOLÉ' }}
                      </a>
                    {%- endif -%}
                  </div>

                  <!-- Brand Description -->
                  {%- if block.settings.brand_description != blank -%}
                    <p class="luxury-footer__description">
                      {{ block.settings.brand_description }}
                    </p>
                  {%- endif -%}

                  <!-- Contact Us -->
                  {%- if block.settings.contact_phone != blank or block.settings.contact_email != blank or block.settings.contact_address != blank -%}
                    <div class="luxury-footer__contact" style="--footer-accent-color: {{ block.settings.contact_icon_color | default: '#D4AF37' }};">
                      {%- if block.settings.contact_heading != blank -%}
                        <h3 class="luxury-footer__heading luxury-footer__heading--contact">
                          {{ block.settings.contact_heading }}
                        </h3>
                      {%- endif -%}
                      <ul class="luxury-footer__contact-list" role="list">
                        {%- if block.settings.contact_phone != blank -%}
                          {%- assign clean_phone = block.settings.contact_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' | replace: '+', '' -%}
                          <li class="luxury-footer__contact-item">
                            <span class="luxury-footer__contact-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                              </svg>
                            </span>
                            <a href="tel:{{ clean_phone }}" class="luxury-footer__contact-link">
                              {{ block.settings.contact_phone }}
                            </a>
                          </li>
                        {%- endif -%}

                        {%- if block.settings.contact_email != blank -%}
                          <li class="luxury-footer__contact-item">
                            <span class="luxury-footer__contact-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                              </svg>
                            </span>
                            <a href="mailto:{{ block.settings.contact_email }}" class="luxury-footer__contact-link">
                              {{ block.settings.contact_email }}
                            </a>
                          </li>
                        {%- endif -%}

                        {%- if block.settings.contact_address != blank -%}
                          <li class="luxury-footer__contact-item">
                            <span class="luxury-footer__contact-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                              </svg>
                            </span>
                            <span class="luxury-footer__contact-text">
                              {{ block.settings.contact_address }}
                            </span>
                          </li>
                        {%- endif -%}
                      </ul>
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'link_list' -%}
                <!-- Navigation Menu Column -->
                <div class="luxury-footer__col luxury-footer__col--menu" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h3 class="luxury-footer__heading">
                      {{ block.settings.heading }}
                    </h3>
                  {%- endif -%}
                  {%- assign menu_links = linklists[block.settings.menu].links -%}
                  {%- if menu_links != blank and menu_links.size > 0 -%}
                    <ul class="luxury-footer__menu-list" role="list">
                      {%- for link in menu_links -%}
                        <li class="luxury-footer__menu-item">
                          <a href="{{ link.url }}" class="luxury-footer__menu-link">
                            {{ link.title }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

              {%- when 'social' -%}
                <!-- Social Links Column -->
                <div class="luxury-footer__col luxury-footer__col--social" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h3 class="luxury-footer__heading">
                      {{ block.settings.heading }}
                    </h3>
                  {%- endif -%}

                  {%- liquid
                    assign instagram_url = block.settings.social_instagram_url | default: settings.social_instagram_link
                    assign facebook_url = block.settings.social_facebook_url | default: settings.social_facebook_link
                    assign tiktok_url = block.settings.social_tiktok_url | default: settings.social_tiktok_link
                    assign youtube_url = block.settings.social_youtube_url | default: settings.social_youtube_link
                    assign pinterest_url = block.settings.social_pinterest_url | default: settings.social_pinterest_link
                    assign linkedin_url = block.settings.social_linkedin_url
                    assign x_url = block.settings.social_x_url | default: settings.social_twitter_link
                  -%}

                  <ul class="luxury-footer__social-list" role="list">
                    {%- if instagram_url != blank -%}
                      <li class="luxury-footer__social-item">
                        <a href="{{ instagram_url }}" class="luxury-footer__social-link" target="_blank" rel="noopener noreferrer">
                          {%- if block.settings.show_social_icons -%}
                            <span class="luxury-footer__social-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                              </svg>
                            </span>
                          {%- endif -%}
                          <span>Instagram</span>
                        </a>
                      </li>
                    {%- endif -%}

                    {%- if facebook_url != blank -%}
                      <li class="luxury-footer__social-item">
                        <a href="{{ facebook_url }}" class="luxury-footer__social-link" target="_blank" rel="noopener noreferrer">
                          {%- if block.settings.show_social_icons -%}
                            <span class="luxury-footer__social-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                              </svg>
                            </span>
                          {%- endif -%}
                          <span>Facebook</span>
                        </a>
                      </li>
                    {%- endif -%}

                    {%- if tiktok_url != blank -%}
                      <li class="luxury-footer__social-item">
                        <a href="{{ tiktok_url }}" class="luxury-footer__social-link" target="_blank" rel="noopener noreferrer">
                          {%- if block.settings.show_social_icons -%}
                            <span class="luxury-footer__social-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.85.12V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.3 6.3 0 0 0 1.86-4.49v-7a8.16 8.16 0 0 0 4.91 1.64V6.85a4.85 4.85 0 0 1-1-.16z"/>
                              </svg>
                            </span>
                          {%- endif -%}
                          <span>TikTok</span>
                        </a>
                      </li>
                    {%- endif -%}

                    {%- if youtube_url != blank -%}
                      <li class="luxury-footer__social-item">
                        <a href="{{ youtube_url }}" class="luxury-footer__social-link" target="_blank" rel="noopener noreferrer">
                          {%- if block.settings.show_social_icons -%}
                            <span class="luxury-footer__social-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                                <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
                              </svg>
                            </span>
                          {%- endif -%}
                          <span>YouTube</span>
                        </a>
                      </li>
                    {%- endif -%}

                    {%- if pinterest_url != blank -%}
                      <li class="luxury-footer__social-item">
                        <a href="{{ pinterest_url }}" class="luxury-footer__social-link" target="_blank" rel="noopener noreferrer">
                          {%- if block.settings.show_social_icons -%}
                            <span class="luxury-footer__social-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 0a12 12 0 0 0-4.37 23.18c-.07-.98-.13-2.49.03-3.56l1-4.22s-.25-.5-.25-1.25c0-1.17.68-2.05 1.52-2.05.72 0 1.07.54 1.07 1.18 0 .72-.46 1.8-.7 2.8-.2.83.42 1.52 1.24 1.52 1.49 0 2.63-1.57 2.63-3.83 0-2-1.44-3.4-3.5-3.4-2.38 0-3.77 1.79-3.77 3.63 0 .72.28 1.49.62 1.9.07.09.08.16.06.25l-.23.95c-.04.15-.13.18-.3.11-1.11-.52-1.8-2.14-1.8-3.45 0-2.8 2.04-5.38 5.88-5.38 3.09 0 5.48 2.2 5.48 5.14 0 3.06-1.93 5.53-4.61 5.53-.9 0-1.75-.47-2.04-1.02l-.56 2.12c-.2.78-.74 1.75-1.1 2.34A12 12 0 1 0 12 0z"/>
                              </svg>
                            </span>
                          {%- endif -%}
                          <span>Pinterest</span>
                        </a>
                      </li>
                    {%- endif -%}

                    {%- if linkedin_url != blank -%}
                      <li class="luxury-footer__social-item">
                        <a href="{{ linkedin_url }}" class="luxury-footer__social-link" target="_blank" rel="noopener noreferrer">
                          {%- if block.settings.show_social_icons -%}
                            <span class="luxury-footer__social-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                                <rect x="2" y="9" width="4" height="12"></rect>
                                <circle cx="4" cy="4" r="2"></circle>
                              </svg>
                            </span>
                          {%- endif -%}
                          <span>LinkedIn</span>
                        </a>
                      </li>
                    {%- endif -%}

                    {%- if x_url != blank -%}
                      <li class="luxury-footer__social-item">
                        <a href="{{ x_url }}" class="luxury-footer__social-link" target="_blank" rel="noopener noreferrer">
                          {%- if block.settings.show_social_icons -%}
                            <span class="luxury-footer__social-icon" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                              </svg>
                            </span>
                          {%- endif -%}
                          <span>X (Twitter)</span>
                        </a>
                      </li>
                    {%- endif -%}
                  </ul>
                </div>

              {%- when '@app' -%}
                <div class="luxury-footer__app-block" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <!-- Bottom Information Row (Copyright & Credit) -->
      <div class="luxury-footer__bottom-row">
        <div class="luxury-footer__copyright">
          {%- if section.settings.enable_copyright -%}
            {%- assign current_year = 'now' | date: '%Y' -%}
            {%- assign default_copyright = '© ' | append: current_year | append: ' SEOLÉ. All rights reserved.' -%}
            <span class="luxury-footer__copyright-text">
              {%- if section.settings.copyright_text != blank -%}
                {{ section.settings.copyright_text | replace: '[year]', current_year }}
              {%- else -%}
                {{ default_copyright }}
              {%- endif -%}
            </span>
          {%- endif -%}
        </div>

        {%- if section.settings.payment_enable and shop.enabled_payment_types.size > 0 -%}
          <div class="luxury-footer__payments">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t | default: 'Payment methods' }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="luxury-footer__credit">
          {%- if section.settings.enable_credit and section.settings.credit_text != blank -%}
            <span class="luxury-footer__credit-text">
              {{ section.settings.credit_text }}
            </span>
          {%- endif -%}
        </div>
      </div>

      <!-- GIANT BRAND WORDMARK (Most Important Visual Feature) -->
      {%- if section.settings.wordmark_enable -%}
        <div class="luxury-footer__wordmark-wrap" aria-hidden="true">
          <span class="luxury-footer__wordmark{% if section.settings.wordmark_enable_gradient %} luxury-footer__wordmark--gradient{% endif %}">
            {{ section.settings.wordmark_text | default: 'SEOLÉ' }}
          </span>
        </div>
      {%- endif -%}
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Luxury Footer",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "brand_contact",
      "name": "Brand & Contact Us",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Brand Logo Image"
        },
        {
          "type": "range",
          "id": "brand_logo_width",
          "min": 50,
          "max": 300,
          "step": 5,
          "unit": "px",
          "label": "Logo Width",
          "default": 130
        },
        {
          "type": "text",
          "id": "brand_text",
          "label": "Fallback Brand Text",
          "default": "SEOLÉ"
        },
        {
          "type": "textarea",
          "id": "brand_description",
          "label": "Brand Description",
          "default": "Premium skincare inspired by elegance, purity, and everyday confidence."
        },
        {
          "type": "text",
          "id": "contact_heading",
          "label": "Contact Heading",
          "default": "Contact Us"
        },
        {
          "type": "text",
          "id": "contact_phone",
          "label": "Phone Number",
          "default": "+1 (800) 123-4567"
        },
        {
          "type": "text",
          "id": "contact_email",
          "label": "Email Address",
          "default": "contact@seole.com"
        },
        {
          "type": "text",
          "id": "contact_address",
          "label": "Address (Optional)"
        },
        {
          "type": "color",
          "id": "contact_icon_color",
          "label": "Contact Icons Color",
          "default": "#D4AF37"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Navigation Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Menu Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "main-menu"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social Links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Social Heading",
          "default": "Social"
        },
        {
          "type": "checkbox",
          "id": "show_social_icons",
          "label": "Display Social Icons",
          "default": true
        },
        {
          "type": "url",
          "id": "social_instagram_url",
          "label": "Instagram URL"
        },
        {
          "type": "url",
          "id": "social_facebook_url",
          "label": "Facebook URL"
        },
        {
          "type": "url",
          "id": "social_tiktok_url",
          "label": "TikTok URL"
        },
        {
          "type": "url",
          "id": "social_youtube_url",
          "label": "YouTube URL"
        },
        {
          "type": "url",
          "id": "social_pinterest_url",
          "label": "Pinterest URL"
        },
        {
          "type": "url",
          "id": "social_linkedin_url",
          "label": "LinkedIn URL"
        },
        {
          "type": "url",
          "id": "social_x_url",
          "label": "X (Twitter) URL"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "General Appearance"
    },
    {
      "type": "color",
      "id": "footer_bg_color",
      "label": "Footer Background Color",
      "default": "#0D0D0D"
    },
    {
      "type": "range",
      "id": "footer_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Container Border Radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "outer_margin",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Container Outer Margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 64
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body / Link Text Color",
      "default": "#A3A3A3"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link Hover Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Bottom Information Row"
    },
    {
      "type": "checkbox",
      "id": "enable_copyright",
      "label": "Show Copyright",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© [year] SEOLÉ. All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "enable_credit",
      "label": "Show Credit Text",
      "default": true
    },
    {
      "type": "text",
      "id": "credit_text",
      "label": "Credit Text",
      "default": "Designed by SEOLÉ"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show Payment Icons",
      "default": false
    },
    {
      "type": "header",
      "content": "Giant Brand Wordmark"
